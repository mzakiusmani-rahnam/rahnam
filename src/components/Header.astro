---
---

<header id="top" class="site-header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="RAHNAM home">
      RAHNAM
    </a>

    <nav class="desktop-nav" aria-label="Main navigation">
      <a href="/">Home</a>
      <a href="/services">Services</a>
      <a href="/case-studies">Case Studies</a>
      <a href="/about">About</a>
      <a href="/insights">Insights</a>
      <a href="/contact">Contact</a>
    </nav>

    <a href="/contact" class="header-cta">
      Start a conversation
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-label="Open navigation"
      aria-expanded="false"
      aria-controls="mobile-navigation"
    >
      <span></span>
      <span></span>
    </button>
  </div>

  <nav
    id="mobile-navigation"
    class="mobile-nav"
    aria-label="Mobile navigation"
    hidden
  >
    <a href="/">Home</a>
    <a href="/services">Services</a>
    <a href="/case-studies">Case Studies</a>
    <a href="/about">About</a>
    <a href="/insights">Insights</a>
    <a href="/contact">Contact</a>
  </nav>
</header>

<style>
  
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  border-bottom: 1px solid var(--color-border);
  background: rgba(11, 17, 24, 0.96);
  backdrop-filter: blur(14px);
  -webkit-backdrop-filter: blur(14px);
  transform: translateY(0);
  transition: transform 240ms ease;
  will-change: transform;
}

.site-header.is-hidden {
  transform: translateY(-100%);
  pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
  .site-header {
    transition: none;
  }
}
  .header-inner {
    width: min(
      calc(100% - (var(--container-padding) * 2)),
      var(--container-width)
    );

    min-height: 84px;
    margin-inline: auto;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  .brand {
    flex-shrink: 0;

    color: var(--color-text);

    font-size: 0.9rem;
    font-weight: 600;
    letter-spacing: 0.2em;

    transition:
      opacity var(--transition-fast),
      transform var(--transition-medium);
  }

  .brand:hover {
    opacity: 0.7;
    transform: translateX(2px);
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(20px, 2.5vw, 36px);

    margin-left: auto;
    margin-right: auto;
  }

  .desktop-nav a {
    position: relative;

    color: var(--color-text-muted);

    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.03em;

    transition: color var(--transition-fast);
  }

  .desktop-nav a::after {
    content: "";

    position: absolute;
    left: 0;
    bottom: -7px;

    width: 100%;
    height: 1px;

    background: var(--color-text);

    transform: scaleX(0);
    transform-origin: right;

    transition: transform var(--transition-medium);
  }

  .desktop-nav a:hover {
    color: var(--color-text);
  }

  .desktop-nav a:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .header-cta {
    flex-shrink: 0;

    padding: 11px 16px;

    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);

    color: var(--color-text);

    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;

    transition:
      background var(--transition-medium),
      border-color var(--transition-medium),
      color var(--transition-medium),
      transform var(--transition-medium);
  }

  .header-cta:hover {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-text-dark);
    transform: translateY(-1px);
  }

  .menu-toggle,
  .mobile-nav {
    display: none;
  }

  @media (max-width: 900px) {
    .desktop-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: flex;
      width: 42px;
      height: 42px;

      padding: 0;
      border: 1px solid var(--color-border);

      background: transparent;
      color: var(--color-text);

      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 6px;

      border-radius: var(--radius-sm);
    }

    .menu-toggle span {
      display: block;
      width: 18px;
      height: 1px;

      background: currentColor;

      transition:
        transform var(--transition-medium),
        opacity var(--transition-fast);
    }

    .mobile-nav {
      padding: 8px var(--container-padding) 24px;

      border-top: 1px solid var(--color-border);

      flex-direction: column;
    }

    .mobile-nav:not([hidden]) {
      display: flex;
    }

    .mobile-nav a {
      padding: 15px 0;

      border-bottom: 1px solid var(--color-border);

      color: var(--color-text-muted);

      font-size: 0.9rem;

      transition: color var(--transition-fast);
    }

    .mobile-nav a:hover {
      color: var(--color-text);
    }
  }
</style>

<script>
  const menuToggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const mobileNav = document.querySelector<HTMLElement>(".mobile-nav");

  if (menuToggle && mobileNav) {
    const setMenuOpen = (isOpen: boolean) => {
      menuToggle.setAttribute("aria-expanded", String(isOpen));
      menuToggle.setAttribute("aria-label", isOpen ? "Close navigation" : "Open navigation");
      mobileNav.hidden = !isOpen;
    };

    menuToggle.addEventListener("click", () => {
      setMenuOpen(menuToggle.getAttribute("aria-expanded") !== "true");
    });

    mobileNav.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) setMenuOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menuToggle.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        menuToggle.focus();
      }
    });

    window.matchMedia("(min-width: 901px)").addEventListener("change", (event) => {
      if (event.matches) setMenuOpen(false);
    });
  }
  

const siteHeader = document.querySelector<HTMLElement>(".site-header");

if (siteHeader) {
  let lastScrollY = window.scrollY;
  let lastToggleScrollY = window.scrollY;
  let ticking = false;

  const movementThreshold = 8;
  const topVisibilityZone = 80;

  const updateHeader = () => {
    const currentScrollY = Math.max(0, window.scrollY);
    const movement = currentScrollY - lastScrollY;

    if (currentScrollY <= topVisibilityZone) {
      siteHeader.classList.remove("is-hidden");
      lastToggleScrollY = currentScrollY;
    } else if (movement > 0 &&
               currentScrollY - lastToggleScrollY >= movementThreshold) {
      siteHeader.classList.add("is-hidden");
      lastToggleScrollY = currentScrollY;
    } else if (movement < 0 &&
               lastToggleScrollY - currentScrollY >= movementThreshold) {
      siteHeader.classList.remove("is-hidden");
      lastToggleScrollY = currentScrollY;
    }

    lastScrollY = currentScrollY;
    ticking = false;
  };

  window.addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    },
    { passive: true }
  );
}

</script>
