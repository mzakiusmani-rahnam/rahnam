<section class="contact-form">
  <div class="container">
    <div class="contact-form__intro reveal">
      <div class="contact-form__label">
        <span class="eyebrow">START A CONVERSATION</span>
      </div>

      <div class="contact-form__heading">
        <h2>
          Tell me what
          <span>you're working through.</span>
        </h2>

        <p>
          A little context helps. Share what you're trying to solve, improve or
          build, and we'll take it from there.
        </p>
      </div>
    </div>

    <form class="contact-form__form reveal">
      <div class="contact-form__row">
        <div class="form-field">
          <label for="name">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            autocomplete="name"
            placeholder="Your name"
            required
          />
        </div>

        <div class="form-field">
          <label for="email">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            autocomplete="email"
            placeholder="you@company.com"
            required
          />
        </div>
      </div>

      <div class="contact-form__row">
        <div class="form-field">
          <label for="company">Company</label>
          <input
            type="text"
            id="company"
            name="company"
            autocomplete="organization"
            placeholder="Company name"
          />
        </div>

        <div class="form-field">
          <label for="challenge">What can I help with?</label>

          <select id="challenge" name="challenge">
            <option value="" selected>Select an area</option>
            <option value="strategy">Ecommerce Strategy</option>
            <option value="growth">Growth & Expansion</option>
            <option value="technology">Technology & Systems</option>
            <option value="customer-experience">Customer Experience</option>
            <option value="ai">AI & Automation</option>
            <option value="fractional-leadership">Fractional Leadership</option>
            <option value="other">Something else</option>
          </select>
        </div>
      </div>

      <div class="form-field form-field--message">
        <label for="message">Tell me a little more</label>

        <textarea
          id="message"
          name="message"
          rows="6"
          placeholder="What are you trying to solve, improve or build?"
          required></textarea>
      </div>

      <div class="contact-form__submit">
        <button type="submit" class="button">
          Send your message
          <span aria-hidden="true">→</span>
        </button>

        <span class="contact-form__note">
         Your enquiry will be sent securely.
        </span>
      </div>

      <p class="contact-form__status" role="status" aria-live="polite" hidden>
      </p>
    </form>

    <div class="contact-form__footer">
      <span>02 — RAHNAM</span>
      <span>Conversation</span>
    </div>
  </div>
</section>

<script>
  
const contactForm = document.querySelector<HTMLFormElement>(
  ".contact-form__form",
);

const contactStatus = document.querySelector<HTMLElement>(
  ".contact-form__status",
);

const contactSubmitButton =
  contactForm?.querySelector<HTMLButtonElement>(
    'button[type="submit"]',
  );

const contactFunctionUrl =
  "https://vfw6ibjnxhwaf66rvycbfezmmu0moplg.lambda-url.us-east-1.on.aws/";

contactForm?.addEventListener("submit", async (event) => {
  event.preventDefault();

  if (!contactForm || !contactStatus || !contactSubmitButton) {
    return;
  }

  if (!contactForm.reportValidity()) {
    return;
  }

  const formData = new FormData(contactForm);

  const payload = {
    name: String(formData.get("name") ?? "").trim(),
    email: String(formData.get("email") ?? "").trim(),
    company: String(formData.get("company") ?? "").trim(),
    challenge: String(formData.get("challenge") ?? "").trim(),
    message: String(formData.get("message") ?? "").trim(),
  };

  if (
    !payload.name ||
    !payload.email ||
    !payload.message ||
    payload.name.length > 120 ||
    payload.email.length > 254 ||
    payload.company.length > 200 ||
    payload.challenge.length > 100 ||
    payload.message.length > 5000
  ) {
    contactStatus.textContent =
      "Please check your details and keep your message under 5,000 characters.";
    contactStatus.hidden = false;
    return;
  }

  contactSubmitButton.disabled = true;
  contactStatus.textContent = "Sending your message…";
  contactStatus.hidden = false;

  try {
    const response = await fetch(contactFunctionUrl, {
      method: "POST",
      headers: {
        "Content-Type": "application/json",
      },
      body: JSON.stringify(payload),
    });

    const result = await response.json().catch(() => null);

    if (!response.ok || result?.success !== true) {
      throw new Error("Message delivery failed.");
    }

    contactStatus.textContent =
      "Thank you for reaching out. Your message has been sent successfully.";

    contactForm.reset();
  } catch {
    contactStatus.textContent =
      "We couldn't send your message just now. Please try again shortly.";
  } finally {
    contactSubmitButton.disabled = false;
  }
});

</script>

